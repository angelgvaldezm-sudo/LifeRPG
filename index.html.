<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Life RPG</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
  </style>
</head>
<body class="bg-neutral-100 text-neutral-900 antialiased selection:bg-orange-500 selection:text-white">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    function App() {
      const [user, setUser] = useState({ name: 'Ángel', level: 1, xp: 0, coins: 50, hp: 100, maxHp: 100 });
      const [tab, setTab] = useState('today');

      return (
        <div className="max-w-md mx-auto min-h-screen bg-[#f4f4f6] pb-24 shadow-2xl relative">
          {/* Header TopBar */}
          <div className="p-5 bg-white border-b border-neutral-200 flex justify-between items-center sticky top-0 z-40">
            <div>
              <p className="text-xs font-bold uppercase tracking-wider text-neutral-400">Jugador</p>
              <h1 className="text-xl font-extrabold text-neutral-900">{user.name}</h1>
            </div>
            <div className="flex items-center gap-3">
              <div className="flex items-center gap-1 bg-amber-50 px-3 py-1.5 rounded-full border border-amber-200">
                <span className="text-sm font-bold text-amber-700">🪙 {user.coins}</span>
              </div>
              <div className="flex items-center gap-1 bg-rose-50 px-3 py-1.5 rounded-full border border-rose-200">
                <span className="text-sm font-bold text-rose-600">❤️ {user.hp}/{user.maxHp}</span>
              </div>
            </div>
          </div>

          {/* Main View */}
          <div className="p-5 space-y-6">
            {/* Level Card */}
            <div className="bg-neutral-900 text-white p-5 rounded-3xl shadow-xl space-y-3">
              <div className="flex justify-between items-center">
                <span className="text-xs font-bold text-orange-400 uppercase tracking-wider">Nivel actual</span>
                <span className="text-2xl font-black">NIVEL {user.level}</span>
              </div>
              <div className="w-full bg-neutral-800 rounded-full h-3 overflow-hidden p-0.5">
                <div className="bg-gradient-to-r from-orange-500 to-amber-400 h-full rounded-full transition-all duration-500" style={{ width: `${(user.xp % 100)}%` }}></div>
              </div>
              <p className="text-xs text-neutral-400 text-right font-medium">{user.xp % 100} / 100 XP para Nivel {user.level + 1}</p>
            </div>

            {/* Quick Start Box */}
            <div className="bg-white p-5 rounded-3xl border border-neutral-200 shadow-sm space-y-3">
              <h2 className="text-base font-bold text-neutral-900">¡Tu aventura ha comenzado! ⚔️</h2>
              <p className="text-sm text-neutral-600 leading-relaxed">
                Life RPG está activo y funcionando directamente desde tu navegador o celular.
              </p>
              <button 
                onClick={() => setUser(prev => ({ ...prev, xp: prev.xp + 25, coins: prev.coins + 10 }))} 
                className="w-full py-3.5 bg-neutral-900 text-white font-bold rounded-2xl active:scale-95 transition-transform flex items-center justify-center gap-2"
              >
                ✨ Probar Recompensa (+25 XP)
              </button>
            </div>
          </div>

          {/* Bottom Navigation Bar */}
          <div className="fixed bottom-4 left-1/2 -translate-x-1/2 w-[90%] max-w-sm bg-neutral-900 text-white p-2 rounded-full shadow-2xl flex justify-around items-center z-50">
            <button onClick={() => setTab('today')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'today' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Hoy</button>
            <button onClick={() => setTab('quests')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'quests' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Misiones</button>
            <button onClick={() => setTab('boss')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'boss' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Jefe</button>
            <button onClick={() => setTab('profile')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'profile' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Perfil</button>
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
