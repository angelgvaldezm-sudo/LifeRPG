<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Life RPG</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
  </style>

  <!-- React 18 & Babel (Para ejecutar en el navegador sin compilar) -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-neutral-100 text-neutral-900 antialiased selection:bg-orange-500 selection:text-white">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    const roundToNearest10 = (num) => Math.round(num / 10) * 10;

    const thresholdForLevel = (level) => {
      if (level <= 1) return 0;
      return roundToNearest10(205 * Math.pow(level - 1, 1.77));
    };

    const calculateLevelState = (lifetimeXP) => {
      let level = 1;
      while (thresholdForLevel(level + 1) <= lifetimeXP) {
        level++;
      }
      const currentThreshold = thresholdForLevel(level);
      const nextThreshold = thresholdForLevel(level + 1);
      const xpIntoCurrentLevel = lifetimeXP - currentThreshold;
      const xpNeededForNextLevel = nextThreshold - currentThreshold;
      const progress = Math.min(Math.max(xpIntoCurrentLevel / (xpNeededForNextLevel || 1), 0), 1);

      return { level, xpIntoCurrentLevel, xpNeededForNextLevel, progress, lifetimeXP };
    };

    const INITIAL_STATE = {
      onboardingCompleted: true,
      user: {
        id: 'user-player-1',
        name: 'Ángel',
        avatar: '🎯',
        customAvatarUrl: null,
        maxHP: 100,
        currentHP: 100,
        selectedGoals: ['Salud', 'Mente', 'Productividad']
      },
      xpLedger: [{ id: 'xp-init', amount: 0, source: 'system', timestamp: Date.now() }],
      coinsLedger: [{ id: 'c-init', amount: 50, type: 'earn', timestamp: Date.now() }],
      skillsLedger: { Fitness: 25, Conocimiento: 15, Creatividad: 10, Aventura: 5, Social: 5, Finanzas: 10 },
      habits: [
        { id: 'h-1', name: 'Ejercicio o Estiramiento 20m', icon: '🏋️', category: 'Fitness', difficulty: 'Medium', xp: 25, coins: 12, proofRequired: true, streak: 1, linkedToBoss: true },
        { id: 'h-2', name: 'Leer 15 Páginas de un Libro', icon: '📖', category: 'Conocimiento', difficulty: 'Easy', xp: 10, coins: 5, proofRequired: true, streak: 3, linkedToBoss: false },
        { id: 'h-3', name: 'Tomar 2 Litros de Agua', icon: '💧', category: 'Fitness', difficulty: 'Easy', xp: 10, coins: 5, proofRequired: false, streak: 2, linkedToBoss: false }
      ],
      completionsByDate: {},
      enemies: [
        { id: 'e-1', name: 'Doomscrolling Nocturno', icon: '📱', avoidanceCue: 'Dejar el teléfono lejos a las 10 PM', damage: 10 }
      ],
      quests: [
        { id: 'q-1', title: 'Explorador Urbano', category: 'Aventura', description: 'Visita un parque o café nuevo esta semana.', difficulty: 'Fácil', xp: 100, coins: 40, status: 'accepted' }
      ],
      boss: { id: 'boss-1', name: 'RETO FITNESS: 10 ENTRENAMIENTOS', category: 'Fitness', description: 'Completa 10 sesiones para derrotar al Jefe.', targetMetric: 10, currentMetric: 1, unit: 'sesiones', remainingHP: 90, xpReward: 1000, coinReward: 500, completed: false },
      gallery: [],
      shopItems: [
        { id: 'item-potion-small', name: 'Poción Pequeña', icon: '🧪', type: 'game', cost: 100, desc: '+10 HP inmediatamente.' },
        { id: 'rw-coffee', name: 'Café de Especialidad', icon: '☕', type: 'real', cost: 80, desc: 'Disfruta de un gusto personal.' }
      ],
      achievements: [
        { id: 'ach-1', title: 'Primer Paso', icon: '🌱', desc: 'Completa tu primer hábito', unlocked: true },
        { id: 'ach-2', title: 'Titán Fitness', icon: '🏋️', desc: 'Acumula 100 XP en Fitness', unlocked: false }
      ]
    };

    function App() {
      const [data, setData] = useState(() => {
        try {
          const saved = localStorage.getItem('LIFE_RPG_USER_DATA_V12');
          return saved ? JSON.parse(saved) : INITIAL_STATE;
        } catch (e) {
          return INITIAL_STATE;
        }
      });

      const [tab, setTab] = useState('today');
      const [selectedHabit, setSelectedHabit] = useState(null);
      const [previewImg, setPreviewImg] = useState(null);
      const cameraRef = useRef(null);
      const galleryRef = useRef(null);

      const lifetimeXP = useMemo(() => data.xpLedger.reduce((sum, item) => sum + item.amount, 0), [data.xpLedger]);
      const coinBalance = useMemo(() => data.coinsLedger.reduce((sum, item) => sum + item.amount, 0), [data.coinsLedger]);
      const levelInfo = useMemo(() => calculateLevelState(lifetimeXP), [lifetimeXP]);

      const handleImageSelect = (e) => {
        const file = e.target.files && e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onloadend = () => setPreviewImg(reader.result);
          reader.readAsDataURL(file);
        }
      };

      const completeHabit = () => {
        if (!selectedHabit) return;
        
        const earnedXP = selectedHabit.xp;
        const earnedCoins = selectedHabit.coins;

        setData(prev => ({
          ...prev,
          xpLedger: [...prev.xpLedger, { id: `xp-${Date.now()}`, amount: earnedXP }],
          coinsLedger: [...prev.coinsLedger, { id: `c-${Date.now()}`, amount: earnedCoins }],
          gallery: previewImg ? [{ id: `g-${Date.now()}`, title: selectedHabit.name, imageUrl: previewImg, date: 'Hoy' }, ...prev.gallery] : prev.gallery
        }));

        setSelectedHabit(null);
        setPreviewImg(null);
        alert(`🎉 ¡Excelente! Ganaste +${earnedXP} XP y +${earnedCoins} Monedas`);
      };

      return (
        <div className="max-w-md mx-auto min-h-screen bg-[#f4f4f6] pb-24 shadow-2xl relative">
          
          {/* Header */}
          <header className="p-5 bg-white border-b border-neutral-200 flex justify-between items-center sticky top-0 z-40">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-full bg-[#f94a29] flex items-center justify-center text-white font-bold text-lg">
                {data.user.avatar}
              </div>
              <div>
                <p className="text-[10px] font-extrabold uppercase tracking-wider text-neutral-400">Jugador</p>
                <h1 className="text-base font-black text-neutral-900">{data.user.name}</h1>
              </div>
            </div>

            <div className="flex items-center gap-2">
              <div className="flex items-center gap-1 bg-amber-50 px-3 py-1.5 rounded-full border border-amber-200">
                <span className="text-xs font-black text-amber-700">🪙 {coinBalance}</span>
              </div>
              <div className="flex items-center gap-1 bg-rose-50 px-3 py-1.5 rounded-full border border-rose-200">
                <span className="text-xs font-black text-rose-600">❤️ {data.user.currentHP} HP</span>
              </div>
            </div>
          </header>

          <main className="p-5 space-y-5">
            {/* Tarjeta de Nivel */}
            <div className="p-5 bg-neutral-900 text-white rounded-3xl shadow-xl space-y-3">
              <div className="flex justify-between items-center">
                <span className="text-xs font-bold text-orange-400 uppercase tracking-wider">Progreso</span>
                <span className="text-xl font-black">NIVEL {levelInfo.level}</span>
              </div>
              <div className="w-full bg-neutral-800 rounded-full h-2.5 overflow-hidden">
                <div className="bg-[#f94a29] h-full transition-all duration-500" style={{ width: `${levelInfo.progress * 100}%` }}></div>
              </div>
              <p className="text-[11px] text-neutral-400 text-right font-medium">{levelInfo.xpIntoCurrentLevel} / {levelInfo.xpNeededForNextLevel} XP para Nivel {levelInfo.level + 1}</p>
            </div>

            {/* TAB: HOY */}
            {tab === 'today' && (
              <div className="space-y-3">
                <h2 className="text-xs font-extrabold uppercase tracking-wider text-neutral-400">Hábitos Diarios</h2>
                {data.habits.map((habit) => (
                  <div key={habit.id} className="p-4 bg-white rounded-3xl border border-neutral-200 shadow-sm flex items-center justify-between">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-2xl bg-neutral-100 flex items-center justify-center text-xl">
                        {habit.icon}
                      </div>
                      <div>
                        <h3 className="text-sm font-bold text-neutral-900">{habit.name}</h3>
                        <p className="text-xs text-[#f94a29] font-bold">+{habit.xp} XP • +{habit.coins} Monedas</p>
                      </div>
                    </div>
                    <button 
                      onClick={() => setSelectedHabit(habit)}
                      className="bg-[#f94a29] text-white text-xs font-bold px-3.5 py-2 rounded-full shadow-sm hover:bg-[#e03d1e]"
                    >
                      Verificar
                    </button>
                  </div>
                ))}
              </div>
            )}

            {/* TAB: JEFE */}
            {tab === 'boss' && (
              <div className="p-5 bg-white rounded-3xl border border-neutral-200 text-center space-y-3">
                <div className="text-4xl">👹</div>
                <h3 className="text-sm font-black uppercase text-neutral-900">{data.boss.name}</h3>
                <p className="text-xs text-neutral-500">{data.boss.description}</p>
                <div className="w-full bg-neutral-200 h-3 rounded-full overflow-hidden">
                  <div className="bg-red-500 h-full" style={{ width: `${data.boss.remainingHP}%` }}></div>
                </div>
                <p className="text-xs font-bold text-neutral-700">{data.boss.remainingHP}% Vida Restante</p>
              </div>
            )}

            {/* TAB: GALERÍA */}
            {tab === 'journey' && (
              <div className="space-y-3">
                <h2 className="text-xs font-extrabold uppercase tracking-wider text-neutral-400">Galería de Pruebas</h2>
                {data.gallery.length === 0 ? (
                  <p className="text-xs text-neutral-400 text-center py-6">Aún no has guardado fotos de tus hábitos.</p>
                ) : (
                  <div className="grid grid-cols-2 gap-3">
                    {data.gallery.map(g => (
                      <div key={g.id} className="bg-white rounded-2xl overflow-hidden border border-neutral-200 shadow-sm">
                        <img src={g.imageUrl} className="w-full h-28 object-cover" />
                        <p className="p-2 text-xs font-bold truncate">{g.title}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </main>

          {/* Modal de Cámara / Evidencia */}
          {selectedHabit && (
            <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
              <div className="w-full max-w-xs bg-white rounded-3xl p-5 space-y-4 text-center shadow-2xl">
                <h3 className="text-sm font-bold text-neutral-900">Verificar: {selectedHabit.name}</h3>
                
                <input ref={cameraRef} type="file" accept="image/*" capture="environment" onChange={handleImageSelect} className="hidden" />
                <input ref={galleryRef} type="file" accept="image/*" onChange={handleImageSelect} className="hidden" />

                <div className="grid grid-cols-2 gap-2">
                  <button onClick={() => cameraRef.current.click()} className="py-2.5 bg-neutral-100 rounded-2xl text-xs font-bold border border-neutral-200">📷 Cámara</button>
                  <button onClick={() => galleryRef.current.click()} className="py-2.5 bg-neutral-100 rounded-2xl text-xs font-bold border border-neutral-200">🖼️ Galería</button>
                </div>

                {previewImg && (
                  <img src={previewImg} className="w-full h-32 object-cover rounded-2xl border border-neutral-200" />
                )}

                <div className="flex gap-2">
                  <button onClick={() => setSelectedHabit(null)} className="flex-1 py-3 bg-neutral-100 rounded-2xl text-xs font-bold text-neutral-600">Cancelar</button>
                  <button onClick={completeHabit} className="flex-1 py-3 bg-neutral-900 text-white rounded-2xl text-xs font-bold">Completar</button>
                </div>
              </div>
            </div>
          )}

          {/* Navegación Inferior Flotante */}
          <div className="fixed bottom-4 left-1/2 -translate-x-1/2 w-[90%] max-w-sm bg-neutral-900 text-white p-2 rounded-full shadow-2xl flex justify-around items-center z-50">
            <button onClick={() => setTab('today')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'today' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Hoy</button>
            <button onClick={() => setTab('boss')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'boss' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Jefe</button>
            <button onClick={() => setTab('journey')} className={`px-4 py-2 rounded-full text-xs font-bold transition-all ${tab === 'journey' ? 'bg-[#f94a29] text-white' : 'text-neutral-400'}`}>Galería</button>
          </div>

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
